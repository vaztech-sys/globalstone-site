# Copie para .env e preencha. O .env NUNCA vai para o Git.

# Domínio .myshopify.com da loja (não o domínio público).
# Encontre em: admin Shopify > Configurações > Domínios > "Domínio da Shopify"
SHOPIFY_FLAG_STORE=globalstone-florida.myshopify.com

# Somente para CI/CD ou scripts. No dia a dia o `shopify theme dev`
# autentica pelo navegador e você NÃO precisa de token aqui.
# Gere em: admin > Configurações > Apps e canais de vendas >
#          Desenvolver apps > Criar app > Admin API > escopos read_themes/write_themes
SHOPIFY_CLI_THEME_TOKEN=

# Storefront API — só necessário se um dia for consumir o catálogo
# fora do tema (app externo, landing page separada).
SHOPIFY_STOREFRONT_API_TOKEN=
